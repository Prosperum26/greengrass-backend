# Core runtime
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/greengrass?schema=public&connection_limit=10

# Auth and security
JWT_SECRET=replace-with-strong-32-char-secret
JWT_REFRESH_SECRET=replace-with-strong-32-char-refresh-secret
QR_SECRET=replace-with-strong-16-char-qr-secret

# Optional OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional media upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MAX_FILE_SIZE=5242880

# Optional AI integration
OPENROUTER_API_KEY=your-openrouter-api-key

# Admin account (for seed)
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-admin-password
ADMIN_FULL_NAME=System Admin

# Logging
LOG_LEVEL=debug
SERVICE_NAME=greengrass-api
