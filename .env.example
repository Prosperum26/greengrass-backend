# ==========================================
# REQUIRED SECURITY CONFIGURATION
# ==========================================

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/greengrass?schema=public"

# JWT Authentication (REQUIRED - min 32 characters)
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-key-min-32-characters-long!!!"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-characters!!!"

# QR Check-in Secret (REQUIRED - min 16 characters)
QR_SECRET="your-qr-secret-key-min-16-chars"

# Google OAuth (optional - for Google login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Server
PORT=3000
NODE_ENV=development

# CORS Configuration (REQUIRED for security)
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://yourdomain.com"

# ==========================================
# EXTERNAL SERVICES
# ==========================================

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret_here

# Upload Config
MAX_FILE_SIZE=5242880

# Gemini AI (Chatbot) - Optional
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# OBSERVABILITY & LOGGING
# ==========================================

# Log level: debug, info, warn, error (default: debug in dev, info in prod)
LOG_LEVEL=debug

# Optional: Write logs to file (default: console only)
# LOG_FILE_PATH=./logs/app.log

# Service name for log metadata
SERVICE_NAME=greengrass-api

# ==========================================
# MONITORING (Production)
# ==========================================

# Prometheus metrics endpoint (enable with prometheus-client library)
# METRICS_ENABLED=true
# METRICS_PORT=9090

# Application Performance Monitoring (APM) - DataDog, New Relic, etc.
# APM_PROVIDER=datadog
# APM_API_KEY=your-apm-api-key
