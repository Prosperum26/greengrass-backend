# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/greengrass?schema=public"

# JWT Authentication
JWT_SECRET="your-jwt-secret-key-min-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-characters"

# QR Check-in Secret (for dynamic QR token generation)
QR_SECRET="your-qr-secret-key-for-token-generation"

# Google OAuth (optional - for Google login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Server
PORT=3000
NODE_ENV=development

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=dwzxr99ge
CLOUDINARY_API_KEY=498539298145832
CLOUDINARY_API_SECRET=your_api_secret_here

# Upload Config
MAX_FILE_SIZE=5242880

# Gemini AI (Chatbot)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
