generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  REJECTED
  BANNED
}

enum OrgRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  COMPLETED
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PointReason {
  JOIN_EVENT
  CHECK_IN
  COMPLETE_EVENT
  STREAK_BONUS
  REFERRAL
  MANUAL_ADJUSTMENT
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  fullName String
  password String?
  role     UserRole @default(STUDENT)

  totalPoints   Int @default(0)
  currentStreak Int @default(0)

  status       UserStatus @default(ACTIVE)
  refreshToken String?

  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  lastActivityAt DateTime @updatedAt

  organizerRequests OrganizerRequest[]

  eventRegistrations EventRegistration[]
  pointHistories     PointHistory[]
  userBadges         UserBadge[]
  
  // THÊM: Mối quan hệ User làm người tổ chức sự kiện
  organizedEvents    Event[]    @relation("EventOrganizer")

  @@index([totalPoints])
  @@index([lastActivityAt])
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  location    String
  latitude    Float
  longitude   Float
  startTime   DateTime
  endTime     DateTime
  points      Int
  qrSecret    String
  status      EventStatus @default(UPCOMING)

  // THÊM: Cột lưu ID người tổ chức
  organizerId String
  organizer   User        @relation("EventOrganizer", fields: [organizerId], references: [id])

  eventRegistrations EventRegistration[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrganizerRequest {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationName String
  description      String?

  status OrgRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
}

model EventRegistration {
  id          String             @id @default(uuid())
  userId      String
  eventId     String
  status      RegistrationStatus @default(REGISTERED)
  checkInTime DateTime?
  proofUrl    String?
  proofStatus ProofStatus        @default(PENDING)
  
  // THÊM: Cột lưu thời gian đăng ký
  createdAt   DateTime           @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model PointHistory {
  id        String      @id @default(uuid())
  userId    String
  amount    Int
  reason    PointReason
  eventId   String?
  metadata  Json?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Badge {
  id             String @id @default(uuid())
  name           String @unique
  description    String
  iconUrl        String
  pointThreshold Int

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}
